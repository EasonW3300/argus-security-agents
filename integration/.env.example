# 复制为 integration/.env；此文件只保留示例，绝不填写或提交真实密钥。
# 本项目在 agent-compose.yml 中显式加载 integration/.env。

# Web UI 专用 Git Workspace。复制为 integration/.env 后填写只读 Token；绝不提交。
GITHUB_REPOSITORY_URL=https://github.com/EasonW3300/argus-security-agents.git
GITHUB_REPOSITORY_REF=feature/scenario-o2-eval
GITHUB_READ_TOKEN=

# 所有场景共用的 Agent 模型配置。Qwen 示例：
AGENT_PROVIDER=qwen
AGENT_MODEL=qwen3.5-flash
DASHSCOPE_API_KEY=replace-with-your-key
AGENT_API_KEY=
AGENT_BASE_URL=
AGENT_RESPONSE_MODE=
AGENT_REQUEST_TIMEOUT_SECONDS=90
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
JUDGE_PROVIDER=
JUDGE_MODEL=
JUDGE_API_KEY=

# Judge 未设置时继承 Agent 配置；如需独立模型可取消注释：
# JUDGE_PROVIDER=qwen
# JUDGE_MODEL=qwen3.5-flash
# JUDGE_API_KEY=replace-with-your-key

# DeepSeek/OpenAI/custom OpenAI-compatible 服务按需填写。
# AGENT_BASE_URL=https://your-openai-compatible-endpoint/v1
# AGENT_API_KEY=replace-with-your-key
# AGENT_RESPONSE_MODE=prompt_json
